#!/usr/bin/env bash
# Pre-push gate: the two checks that are fast enough to run on every push.
#
# Install with `bash scripts/install-hooks.sh`; bypass a single push with
# `git push --no-verify`.
#
# WHAT IS HERE, AND WHAT IS DELIBERATELY NOT
# ------------------------------------------
# Only checks that finish in seconds. Jest (~6 min), the typecheck and the E2E
# suite are NOT here on purpose: a pre-push hook that takes minutes gets
# bypassed with --no-verify as a habit, and a gate everyone routinely skips is
# worse than no gate, because it still reads like coverage in a review.
#
#   check-spec-refs.sh          reference integrity across specs/*.allium.
#                               `allium check` proves SYNTAX only, so nothing
#                               else in this repo would catch a spec naming an
#                               entity that does not exist. Sixteen such defects
#                               were found across eight files on 2026-09-05.
#   check-notification-writers  the SingleNotificationWriter invariant (ADR-030).
#
# RELATION TO GITHUB CI
# ---------------------
# Both checks also run in .github/workflows/ci.yml, which installs a pinned
# `allium` from the juxt/allium-tools releases. This hook is not a substitute
# for that — it is the earlier of the two, and the only one that runs for a
# push to a branch CI does not watch (CI triggers on main and dev).
#
# An earlier version of this comment claimed allium had "no published install
# step" and that CI therefore could not run the spec gate. That was wrong, and
# wrong from a local-only check: not being in package.json and sitting as a
# hand-installed binary in ~/bin says nothing about how it is distributed.
# Upstream ships prebuilt x86_64 Linux archives per release.
#
# EXIT 2 FROM check-spec-refs BLOCKS THE PUSH
# -------------------------------------------
# Exit 2 means the checker could not run — allium or python3 missing — so
# NOTHING was examined. Treating that as a pass is precisely how a gate stops
# gating without anyone noticing, and the script separates 2 from 0 so that this
# choice can be made here rather than assumed. It is a choice, not a law: if you
# work on a machine without allium, either install it or flip the branch below
# to warn-and-allow.
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT" || exit 1

fail=0

echo "[pre-push] spec reference integrity ..."
bash scripts/check-spec-refs.sh
case $? in
  0) ;;
  2)
    echo "[pre-push] BLOCKED: the spec-reference checker could not run, so no spec was checked." >&2
    echo "[pre-push]          Install allium, or push with --no-verify if you accept the gap." >&2
    fail=1
    ;;
  *)
    echo "[pre-push] BLOCKED: unresolved spec references (listed above)." >&2
    fail=1
    ;;
esac

echo "[pre-push] notification writers ..."
if ! bash scripts/check-notification-writers.sh; then
  echo "[pre-push] BLOCKED: a notification is written outside the allowed files (ADR-030)." >&2
  fail=1
fi

if [ "$fail" -ne 0 ]; then
  echo "[pre-push] push refused. Fix the above, or bypass once with: git push --no-verify" >&2
  exit 1
fi

echo "[pre-push] OK"
exit 0
