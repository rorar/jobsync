# prisma sqlite database
dev.db
dev.db-journal
dev.db.backup-*

# E2E disposable run database (scripts/e2e-db.sh). The template is a build
# artefact rebuilt from schema + migrations + seeds; the run copy dies with the
# next run. Neither belongs in git, and neither is the developer's dev.db.
prisma/.e2e-template.db*
prisma/.e2e-template.stamp
prisma/.e2e-run.db*
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
data/files/resumes
data/logos
.github/*
!.github/workflows
.claude/settings.local.json
# headroom wrap writes per-run markers next to the settings it borrows
.claude/.headroom_wrap_*
.specify
# /specs — Allium specs are now tracked in git (19 specs, 8000+ lines)
.vscode
AGENTS.md

# devenv
.devenv
.devenv.flake.nix
devenv.lock
logs/sessions/
.domain-experts/

# Agent/MCP tool state — local caches and per-machine config, never shared
.headroom/
.serena/

# Stray nohup logs. `scripts/restart.sh` run under nohup without a redirect drops
# one next to the script; test-e2e.sh redirects to /tmp deliberately, so any
# nohup.out in the tree is an accident.
nohup.out
__pycache__/
