-- allium: 3
-- e2e-test-infrastructure.allium

-- Scope: E2E test execution infrastructure for JobSync
-- Includes: Test categorization, auth state management, execution pipeline, data isolation,
--           disposable per-run database, fixture-owned entity lifecycle, console oracle scope,
--           per-worktree dev server ownership (port, lock, ownership-checked stop),
--           post-run residue classification (growth, seed mutation, debt vs permission)
-- Excludes:
--   - Individual test assertions (domain-level, not infrastructure)
--   - Unit/component test infrastructure (Jest, separate concern)
--     EXCEPT the two Jest/shell checks that ENFORCE invariants declared here:
--     __tests__/e2e-no-swallowed-assertions.spec.ts and
--     scripts/check-e2e-residue.sh. They live in the other pyramid layer for
--     deployment reasons (Jest runs in CI, Playwright does not); what they
--     enforce is in scope, and is named at the invariants they enforce.
--   - CI/CD pipeline definition (GitHub Actions, separate concern)
-- Dependencies: User entity defined in jobsync.allium

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

external entity PlaywrightRunner {
    projects: List<Project>
    global_setup: GlobalSetup?
    workers: Integer
    timeout: Duration
    web_server: WebServerConfig
}

external entity NextAuthSession {
    cookies: String                -- serialized cookie jar
    expires_at: Timestamp
}

external entity SQLiteDatabase {
    path: String                   -- "prisma/dev.db"
    -- The DEVELOPER'S working database, owned by the dev server and the seed
    -- script. Since DisposableRunDatabase the suite never opens this file: it
    -- runs against a per-run copy of a seeded template instead.
    -- It is modelled here solely so the suite can assert it stays untouched
    -- (invariant RunDatabaseIsNeverTheWorkingDatabase).
}

external entity WebServerConfig {
    command: String
    reuse_existing_server: Boolean
    base_url: String
    -- Was a constant "http://localhost:3737" in playwright.config.ts. It is now
    -- read from the environment (E2E_BASE_URL) because the port is a property of
    -- the WORKTREE, not of the project — see invariant WorktreeScopedPort.
    -- Playwright's baseURL, its webServer.url and the server's own NEXTAUTH_URL
    -- must all carry the same value: a disagreement surfaces as a hanging login
    -- or a post-logout wait on a host the browser is not on, far from its cause.
}

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

value AuthState {
    storage_state_path: String     -- "e2e/.auth/user.json"
    user_email: String             -- "admin@example.com"
    created_at: Timestamp
    session: NextAuthSession
}

value TestDataIdentifier {
    uid: String                    -- millisecond stamp + worker, e.g. "m1abc2dw0"
    -- Was: "Date.now().toString(36), e.g. m1abc2d" — the timestamp alone, which
    -- is unique only while ONE worker runs. Since 4447b9fe (E2E-B29) the uid is
    -- that stamp plus `w` plus the worker index, because the identifier has to
    -- discriminate on both axes it can collide on: WHEN and WHO.
    -- Note: prefix is not used in practice. Tests use "{Label} {uid}" format
    -- (e.g., "Co m1abc2dw0", "Tag m1abc2dw0") which is sufficiently unique.
    -- Since DisposableRunDatabase the uid is an INTRA-run device only: it keeps
    -- concurrent workers inside one run from colliding. Cross-run hygiene is
    -- the disposable database's job. The "E2E " name prefix likewise survives
    -- only as a reading aid and as the filter the legacy cleanup script uses;
    -- it is no longer the mechanism that keeps runs from contaminating runs.
}

------------------------------------------------------------
-- Contracts
------------------------------------------------------------

contract TestConventions {
    @invariant ChromiumOnly
        -- Only Chromium is configured as a browser project.
        -- Firefox and WebKit are not included.

    @invariant BunNotNpm
        -- webServer fallback command uses "bun run dev", not "npm run dev".

    @invariant NoSerialDescribes
        -- No test file uses test.describe.serial.
        -- All tests within a file are independently runnable.

    @invariant NoCrossTestDependency
        -- No test reads data created by a different test.
        -- Each test is hermetic — it can run alone and in any order.

    @invariant StorageStateGitignored
        -- The .auth/ directory containing session cookies is never committed.

    @invariant SingleSourceHelpers
        -- ALL reusable E2E utilities live under e2e/helpers/, and
        -- e2e/helpers/index.ts is the import surface: a spec file imports
        -- "../helpers" unless the utility it needs is a module index.ts does
        -- not re-export.
        -- Splitting helpers into internal modules under e2e/helpers/ is NOT a
        -- violation — fixtures.ts, console-oracle.ts and resume-fixture.ts are
        -- expected shapes. What stays forbidden is a SPEC FILE carrying its own
        -- copy of a shared helper: that is what let one renamed toast leave six
        -- private copies of the same resume fixture half-repaired for five
        -- months.
        -- No test file defines its own login(), selectOrCreateComboboxOption(),
        -- expectToast(), uniqueId(), tracked-entity factory or console oracle.
        -- Exception: signin.spec.ts may define inline login (tests the auth flow itself).
        -- Exception: locale-switching.spec.ts may define locale-aware login variant.
        -- (Was: "ALL reusable E2E utilities live in e2e/helpers/index.ts",
        -- which forbade the very extraction the suite needed.)

    @invariant PerRunDatabaseIsolation
        -- Renamed from SharedDatabaseIsolation, which described a single
        -- long-lived prisma/dev.db shared by every run.
        -- Each RUN owns its database: a copy of the seeded template, discarded
        -- at the NEXT provisioning. Runs cannot observe each other's rows and no
        -- run can leave residue for the next, by construction rather than by
        -- cleanup.
        -- "At the next provisioning" rather than "when the run ends" is what
        -- makes the isolation and the post-mortem compatible: the file outlives
        -- the run that wrote it, and is gone before any run that could read it.
        -- See DiscardRunDatabase, which said the opposite for six hours.
        -- WITHIN a run the tests still share one database, so the intra-run
        -- half of the old rule stands unchanged: no test reads data created by
        -- another test, and all test-created data carries uniqueId() so
        -- concurrent workers cannot collide.

    @invariant SeedDataReadOnly
        -- Seed data (admin user, job sources, job statuses, default profile,
        -- and at least one staged vacancy) is a DETERMINISTIC TEMPLATE, not
        -- whatever the developer's database happens to contain. Two runs of the
        -- same commit start from byte-identical state.
        -- Tests may READ seed data but never MODIFY it. Under a per-run
        -- database a modification corrupts only that run's copy — but it still
        -- breaks every later test in that run, so the prohibition stands.

    @invariant StopScopedByConcurrencyNotIdentity
        -- Who may stop a dev server is a question about CONCURRENCY, not about
        -- who they are.
        -- A SUBAGENT must not stop one: it cannot know whether the process on
        -- the port belongs to a sibling three minutes into a suite. The
        -- ORCHESTRATOR and the wrappers may, because they are the only parties
        -- in a position to know that nothing else is running.
        -- Recorded as "nobody may ever stop the dev server" the rule inverts its
        -- own purpose: on 2026-09-02 it argued for leaving an ORPHANED
        -- `bun run dev` tree (PPID 1, its systemd scope already dead) holding
        -- 4.3 GB and the base port — owned by no run, and reclaimed by nothing.
        -- Since rule OwnershipCheckedStop the worktree half is enforced
        -- mechanically, so this prohibition is no longer the only thing standing
        -- between a worker and a sibling's server. It stands anyway because a
        -- bare `kill` does not go through the check: the guarantee lives in the
        -- wrapper, so stopping outside the wrapper forfeits it.
        -- This is prose, not an expression: "the actor could not have known"
        -- is a property of who was running, not of any entity's state.

    @invariant OneSpecPerAggregate
        -- Each domain aggregate generally has one E2E spec file.
        -- Exception: automation has two files (automation-crud + automation-wizard-modules)
        -- because the wizard's module-specific flows are complex enough
        -- to warrant separation.
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum TestCategory {
    smoke                          -- auth-free, read-only tests
    crud                           -- authenticated CRUD flows
}

enum DomainAggregate {
    auth
    locale
    job
    task
    activity
    automation
    question
    profile
    company
    module_settings
    keyboard_ux
}
-- Note: automation has two spec files (automation-crud + automation-wizard-modules)
-- because the wizard is complex enough to warrant a dedicated test file.
-- keyboard-ux is a cross-cutting spec, not strictly one DDD aggregate.

enum ProjectStatus {
    pending
    running
    passed
    failed
    skipped
}

enum TestOutcome {
    running
    passed
    failed
    skipped                        -- test.skip() was called, at any point
}
-- `skipped` was added when test.skip() became a sanctioned way for a test body
-- to give up (see ConsoleOracleIsNeverTheOnlyAssertion). It is a TERMINAL
-- outcome and it counts as settled: a test that skips mid-body may already have
-- written rows, and the runner still invokes fixture teardown for it, so the
-- rows must still go. Modelling a skip as "not settled" would have exempted
-- exactly the tests most likely to have given up halfway through a create.
-- Distinct from ProjectStatus.skipped, which is a whole project skipped because
-- a dependency failed.

enum TestPhase {
    arrange                        -- navigation and fixture preparation
    act                            -- the interaction under test
    teardown                       -- fixture-owned cleanup
}
-- Note: the literal is "arrange", not "setup", because `setup` is already the
-- conventional binding name for the GlobalSetup instance in this file's rules
-- and a bound name shadows an enum literal.

enum FixtureKind {
    admin_user
    job_source
    job_status
    default_profile
    staged_vacancy                 -- required by e2e/crud/staging-details-sheet.spec.ts
}

enum RunDatabaseStatus {
    provisioned
    discarded
}

enum OwnedRowStatus {
    registered                     -- the fixture knows about the row
    written                        -- the row exists in the run database
    released                       -- the row is provably gone
}

enum ResidueVerdict {
    -- Who is answerable for the rows a model gains during a run. The three
    -- values are NOT degrees of the same thing; they are different claims, and
    -- collapsing any two of them is what an allowlist decays into.
    owned                          -- a test created it and must remove it
    allowed_growth                 -- growth is by design; this is not a leak
    known_debt                     -- this IS a leak, it has a finding, it is unfixed
}
-- The distinction between the last two is the load-bearing one.
-- allowed_growth says "this is not a leak": append-only audit and log tables,
-- rows the health monitor writes for every module, the enrichment cache. No
-- test owns them and no number of them means anything.
-- known_debt says "this is a leak we have not fixed, and here is its number".
-- It does not fail the run, because a gate that is red from its first day gets
-- switched off; it PRINTS on every run instead, and its entry is deleted when
-- the finding is. Filing these under allowed_growth would have bought a green
-- gate by redefining four open findings as design.

enum IntraRunVisibility {
    -- Whether a row left behind can be OBSERVED by a later test in the same run.
    -- This, not the model's convenience, is what decides whether teardown has to
    -- survive a thrown assertion (see FixtureOwnedTeardown).
    capacity_bound                 -- a per-user cap: 10 webhook endpoints, 10 active API keys
    per_user_singleton             -- one row per user: SmtpConfig, VapidConfig
    unique_keyed                   -- a unique constraint a re-create collides with
    invisible                      -- a later test in this run cannot tell it is there
}
-- unique_keyed is the class that is easiest to miss, because nothing about it
-- looks like a limit: JobStatus is unique on (userId, value), CompanyBlacklist
-- on (userId, pattern, matchType), EnrichmentResult on
-- (userId, dimension, domainKey). A leftover row does not fill a quota — it
-- makes the SAME create fail for a later test, which reads as a product bug.

enum DevServerStatus {
    starting                       -- lock taken, not yet answering on the port
    serving
    stopped
}
-- `starting` is a distinct state and not a modelling nicety: the lock is taken
-- BEFORE the process exists, so there is a window in which a port is claimed and
-- nothing answers on it. A caller that polls for "ready" without knowing that
-- window exists reads the claim as an absence and starts a second server.

------------------------------------------------------------
-- Entities
------------------------------------------------------------

entity Project {
    name: String                   -- "smoke" | "crud"
    category: TestCategory
    test_dir: String               -- relative path, e.g. "e2e/smoke"
    storage_state: AuthState?      -- null for smoke, set for crud
    status: ProjectStatus
    dependencies: List<Project>    -- smoke has none, crud depends on smoke
    files: List<TestFile>
}

entity TestFile {
    path: String                   -- e.g. "e2e/crud/job-crud.spec.ts"
    aggregate: DomainAggregate
    category: TestCategory
    test_count: Integer
    uses_storage_state: Boolean
    required_fixtures: Set<FixtureKind>
    -- What the file needs the template to already contain. Declaring it is the
    -- point: staging-details-sheet.spec.ts needs a StagedVacancy and no test
    -- creates one, so its precondition was invisible until it hard-failed.
}

entity GlobalSetup {
    -- Runs once before any project. Provisions the run database, starts the
    -- dev server, then performs UI login and persists auth state.
    auth_state: AuthState
    executable_path: String?       -- PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH for NixOS
    template: SeedTemplate
    database: RunDatabase?         -- absent until ProvisionRunDatabase has run
    reuse_server: Boolean          -- E2E_REUSE_SERVER=1; false by default
    keep_run_database: Boolean     -- E2E_KEEP_RUN_DB; TRUE by default
    -- Default true, which is the unusual direction for a cleanup flag and is
    -- deliberate: see DiscardRunDatabase. Setting it false restores the
    -- discard-at-exit behaviour this spec required until SPEC-B2 was resolved.
    dev_server_started_by_runner: Boolean
    worktree: Worktree             -- the checkout this run belongs to
    dev_server: DevServer?         -- absent until the server is up
    -- worktree is what makes the run's port, its base URL and its stop scope one
    -- decision rather than three: everything the run addresses is derived from
    -- it (invariants WorktreeScopedPort and RunDrivesItsOwnWorktreesServer).
}

entity SeedTemplate {
    -- The deterministically seeded database every run is copied from.
    -- Read-only: no run opens it for writing.
    path: String
    seeded_fixtures: Set<FixtureKind>
    stamp: String
    -- A digest of everything whose change invalidates the template: the schema,
    -- the migrations, and the two seed scripts. It is how a run decides whether
    -- to rebuild, and — carried into the copy — how a POST-run check decides
    -- whether it is allowed to draw a conclusion at all.
}

entity RunDatabase {
    -- One per run: a copy of the template, discarded at the NEXT provisioning.
    path: String
    template: SeedTemplate
    status: RunDatabaseStatus
    file_present: Boolean

    provisioned_at: Timestamp
    template_stamp: String
    -- Provenance, recorded INSIDE the copy rather than beside it. Both fields
    -- exist for the residue gate, and both close a way it could report on
    -- something it did not measure:
    --   provisioned_at is the baseline for "was this seeded row written DURING
    --     the run?". Read from the copy, it is the run's OWN clock; taken from
    --     the file's mtime or from wall time at check time, it drifts.
    --   template_stamp says which template this copy came from. A check that
    --     read the template's CURRENT stamp instead would compare against
    --     whatever the template is now — a rebuild between the run and the
    --     check, or a check invoked hours later, both produce a plausible and
    --     wrong answer. With the baseline in the copy, a mismatch is
    --     DETECTABLE, so the gate skips loudly instead of guessing (see
    --     SettledTestCaseOwnsNoLeakedRow).

    transitions status {
        provisioned -> discarded
        terminal: discarded
    }

    invariant NeverTheTemplateItself {
        path != template.path
    }

    invariant DiscardedMeansFileRemoved {
        status = discarded implies not file_present
    }
}

entity TestCase {
    -- One test(...) body. TestFile is the file; TestCase is a single case in it.
    file: TestFile
    outcome: TestOutcome
    behavioural_assertions: Integer
    -- Assertions other than the console oracle that no catch can swallow.
    -- A source-level count: the checker cannot compute it, but the property it
    -- guards (ConsoleOracleIsNeverTheOnlyAssertion) is worth naming.

    owned_rows: OwnedRow with owner = this
    console_oracle: ConsoleOracle with test_case = this

    leaked_rows: owned_rows where status = written
    has_settled: outcome in {passed, failed, skipped}
}

entity PersistedModel {
    -- A model in the run database, classified by who is answerable for what
    -- happens to its rows during a run. Instances are the SCHEMA's models —
    -- Person, Tag, Resume, ModuleRegistration — not individual rows.
    -- It exists because the residue gate works at this granularity: it can see
    -- that a model gained rows, and it cannot see which test created them. That
    -- is the honest description of the enforcement, and pretending otherwise
    -- would make the invariants below unfalsifiable.
    name: String
    growth: ResidueVerdict
    finding_id: String?            -- the finding that owns the debt, when growth = known_debt
    mutation_allowed: Boolean      -- seeded rows of this model may be left modified
    visibility: IntraRunVisibility
    has_update_clock: Boolean       -- the model carries an updatedAt column
    -- Deliberately referenced by NO invariant, and that silence is the point.
    -- When it is false, seed_rows_mutated is necessarily 0 — not because nothing
    -- was mutated, but because nothing can be seen. Writing that as a formal
    -- clause would make SettledRunRestoresMutatedSeedData hold VACUOUSLY for
    -- exactly the models it cannot check (Profile, Job, Company, JobTitle,
    -- Location), which is worse than leaving the gap named in prose: a reader
    -- would take the green result as coverage. The field exists so the blind
    -- spot has somewhere to live and a name to cite.

    rows_gained: Integer            -- run count minus template count
    seed_rows_mutated: Integer      -- rows from the template written after provisioning
    -- Both are what the GATE measured, not ground truth. rows_gained counts
    -- against the template, so it cannot attribute a row to a test; and it is a
    -- membership question, never a budget — AdminAuditLog is written on every
    -- job mutation and every PII read, the CRM cron writes every 15 minutes, and
    -- the dev server keeps running after the suite exits, so any threshold here
    -- would measure wall clock rather than ownership.

    invariant KnownDebtNamesItsFinding {
        -- Both directions, deliberately. A debt entry without a finding is an
        -- allowlist with the reason filed off; a finding attached to anything
        -- other than debt is a claim that a design decision is a bug.
        (growth = known_debt implies exists finding_id)
        and (exists finding_id implies growth = known_debt)
    }
}

entity OwnedRow {
    -- A row a test created through a tracked factory fixture. The fixture, not
    -- the test body, owns its lifecycle.
    owner: TestCase
    model: PersistedModel
    label: String                  -- "{Label} {uid}", e.g. "E2E Job m1abc2dw0"
    carries_uid: Boolean
    status: OwnedRowStatus
    deletion_confirmed: Boolean

    transitions status {
        registered -> written
        written -> released
        terminal: released
    }

    invariant ReleaseRequiresConfirmedDeletion {
        status = released implies deletion_confirmed
    }
}

entity ConsoleOracle {
    -- An assertion over browser console output for one test case.
    test_case: TestCase
    armed_in: TestPhase            -- phase in which collection starts
    asserted_in: TestPhase         -- phase in which the assertion runs
    tolerations: ConsoleToleration with oracle = this

    invariant ScopedToActPhase {
        armed_in = act and asserted_in = act
    }
}

entity ConsoleToleration {
    -- A console artefact the oracle ignores, together with the condition that
    -- makes ignoring it legitimate.
    oracle: ConsoleOracle
    pattern: String                -- e.g. "favicon", "404"
    condition: String              -- the environment fact being relied on
    condition_holds: Boolean       -- re-evaluated every run

    suppresses: condition_holds
    -- Derived, deliberately: the tolerance IS its condition. There is no way to
    -- express "ignore this always" — when the condition lapses, suppression
    -- lapses with it and the oracle fails closed.
}

entity Worktree {
    -- A checkout of the repository. The MAIN checkout and every linked worktree
    -- are separate instances, and the thing that distinguishes them is the root
    -- PATH — which is also what the port is derived from, so that two tools
    -- asking "which port is ours?" in the same directory cannot disagree.
    root: String                   -- absolute path of the checkout
    is_main_checkout: Boolean      -- git-dir equals git-common-dir
    port: Integer
}

entity DevServer {
    -- The `next dev` process tree serving the app for one worktree.
    -- A tree, not a process: the pid LISTENING on the port is a child, and the
    -- supervisor above it respawns that child within seconds. This is why an
    -- earlier teardown appeared to leave a "new" server behind — it was the
    -- same supervisor, one child later — and why a stop must walk UP before it
    -- signals (see OwnershipCheckedStop).
    worktree: Worktree
    port: Integer
    status: DevServerStatus

    stop_attempts: DevServerStop with target = this
    -- A server accumulates attempts, not one attempt: a refused stop is a
    -- normal event that leaves the server standing, so the refused and the
    -- eventual permitted attempt both name the same target.

    transitions status {
        starting -> serving
        starting -> stopped
        serving -> stopped
        terminal: stopped
    }

    invariant ServesItsOwnWorktreesPort {
        port = worktree.port
    }
}

entity PortLock {
    -- The advisory lock that turns "is anything already claiming this port?"
    -- into a question with an ATOMIC answer. One instance per port, and it is
    -- present for every port: a lock nobody has ever taken and a lock that has
    -- been released are the same state, which is what lets a start ask about
    -- any port without first checking whether the question has been asked.
    -- Why not ask over a message channel: "may I kill this?" answered by a
    -- message is not atomic, because between the answer and the kill the answer
    -- can stop being true. Exclusive access to a resource is a lock problem, not
    -- a conversation problem.
    port: Integer
    holder: DevServer?             -- absent = free
    -- The holder is the SERVER, not the script that acquired the lock. The
    -- descriptor the lock lives on is inherited across exec, so it is released
    -- exactly when the server process dies — including when it is killed — and
    -- there is no cleanup path for anyone to forget.
}

entity DevServerStop {
    -- One attempt to stop a dev server, together with the scope it was made in.
    -- Modelled as an entity because a stop has to carry BOTH coordinates: which
    -- port, and out of which directory. A command line carries neither — every
    -- checkout produces the same argv, which is what made `pkill -f "next dev"`
    -- reach into siblings.
    target: DevServer
    scope_root: String             -- root of the worktree requesting the stop
    machine_wide: Boolean          -- STOP_ALL_WORKTREES=1, the deliberate sweep

    permitted: machine_wide or target.worktree.root = scope_root
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    workers_local: Integer = 3
    workers_ci: Integer = 1
    timeout_default: Duration = 60.seconds
    timeout_expect: Duration = 10.seconds
    timeout_action: Duration = 10.seconds
    retries_ci: Integer = 2
    retries_local: Integer = 0
    dev_server_base_port: Integer = 3737
    worktree_port_span: Integer = 200
    -- Replaces `base_url: String = "http://localhost:3737"`, which was true of
    -- every run until 0e1b5fca and is now true only of the MAIN checkout. There
    -- is no single base URL to name: it is derived per worktree, which is why
    -- the constant became a base port plus a span rather than a different
    -- constant. The main checkout keeps the base port deliberately — it is in
    -- .env, in bookmarks and in muscle memory, and moving it would tax the
    -- common case to serve the rare one.
    -- Was 49. Widened to 200 in f98bb779, and the widening is the lesser half
    -- of that fix: a hash over ANY finite span collides, so the span only makes
    -- a collision rarer, never impossible. What removes it is resolving
    -- collisions deterministically — walk the worktrees in path order and let
    -- the earlier one keep the contested slot. The cost, stated because it is
    -- surprising: ADDING a worktree can move a later one's port. That is visible
    -- (the wrapper prints the port it bound) and beats two checkouts silently
    -- fighting over one.
    chromium_executable: String = "/run/current-system/sw/bin/chromium"
    stability_runs: Integer = 5   -- number of repeated runs for anti-flaky verification
    min_behavioural_assertions: Integer = 1
    -- A console oracle is never a test's only surviving assertion.
}

------------------------------------------------------------
-- Rules: Pipeline Execution
------------------------------------------------------------

rule GlobalSetupRunsFirst {
    -- WHEN a test run starts, the global setup authenticates once
    -- and saves the session to storageState before any project runs.
    when: TestRunStarted(setup)
    requires: setup.auth_state.storage_state_path != null
    ensures: setup.auth_state.created_at = now

    @guidance
        -- The global setup must complete and persist auth state
        -- before any Project begins execution.
}

rule PipelineDependencies {
    -- WHEN projects are scheduled, smoke runs before crud.
    -- If smoke fails, crud is skipped entirely (fail-fast).
    when: ProjectScheduled(project)
    requires: project.dependencies.all(dep => dep.status = passed)
    ensures: project.status = running

    @guidance
        -- A project executes only after all its dependencies pass.
        -- If any dependency has failed, this project is skipped.
}

rule SmokeProjectConfig {
    -- Smoke tests run WITHOUT storageState.
    -- They test the authentication flow itself (signin, locale-switching).
    when: ProjectConfigured(project)
    requires: project.category = smoke
    ensures: project.storage_state = null

    @guidance
        -- All files in a smoke project must not use storageState.
        -- Smoke tests verify the authentication flow itself.
}

rule CrudProjectConfig {
    -- CRUD tests run WITH storageState from global setup.
    -- No per-test login is needed.
    when: ProjectConfigured(project, setup)
    requires: project.category = crud
    requires: setup.auth_state != null
    ensures: project.storage_state = setup.auth_state

    @guidance
        -- All files in a crud project use the storageState from global setup.
        -- No per-test login is needed.
}

------------------------------------------------------------
-- Rules: Disposable Run Database
------------------------------------------------------------

rule ProvisionRunDatabase {
    -- WHEN a run starts, the suite copies the deterministically seeded template
    -- to a fresh file and runs against the COPY.
    -- This is what makes cross-run residue impossible rather than merely
    -- cleaned-up. It also removes the suite's only claim on the developer's
    -- working database, which until now rested on an env-var gate
    -- (E2E_ALLOW_DESTRUCTIVE) that covered ONE unfiltered delete while every
    -- other write went to prisma/dev.db by design.
    when: TestRunStarted(setup)
    requires: not exists setup.database
    ensures:
        let db = RunDatabase.created(
            path: fresh_run_path(setup),
            template: setup.template,
            status: provisioned,
            file_present: true,
            provisioned_at: now,
            template_stamp: setup.template.stamp
        )
        setup.database = db

    @guidance
        -- Copy the template file; do not migrate-and-seed per run. A copy is
        -- deterministic and O(file size); a re-seed is neither, and a template
        -- that is rebuilt rather than copied cannot be byte-compared.
        -- The two provenance fields are written into the COPY, in the same step
        -- that makes it. Recording them anywhere else — beside the file, or
        -- re-derived at check time — reintroduces the ambiguity they exist to
        -- remove; see the comment on RunDatabase.
}

rule DiscardRunDatabase {
    -- WHEN a run starts, the database left standing by the PREVIOUS run is
    -- discarded, BEFORE this run's copy is made. Nothing the suite wrote
    -- survives into a run that could observe it.
    when: TestRunStarted(setup)
    requires: not setup.reuse_server
    for db in RunDatabases where status = provisioned:
        ensures:
            db.status = discarded
            db.file_present = false

    @guidance
        -- Was: `when: TestRunFinished(setup)`, requiring the file gone when the
        -- run ended, "on every terminal outcome, including a failed or
        -- interrupted run", because "a suite that leaves its database behind on
        -- failure has reintroduced exactly the residue this design removes".
        -- That was written the same afternoon as the code that does the
        -- opposite (E2E_KEEP_RUN_DB defaults to 1), by the same author, and was
        -- found by a third reader comparing the two (SPEC-B2). Resolved here in
        -- favour of the CODE, which ADR-045 §3 already states as a decision.
        --
        -- The retired claim's worry is still met, and that is why resolving it
        -- this way costs nothing: residue cannot survive into a run that could
        -- observe it, because provisioning ALWAYS replaces the file before
        -- anything runs. What changes is only how long a dead run's data stays
        -- readable — and three things want it readable:
        --   1. The residue gate (scripts/check-e2e-residue.sh) runs AFTER the
        --      Playwright process exits and READS this database. It is the
        --      enforcement of SettledTestCaseOwnsNoLeakedRow, so a lifetime that
        --      ends before it does would forbid the mechanism that makes another
        --      invariant in this file real.
        --   2. A red run stays inspectable instead of vanishing with the
        --      failure — the run whose data you most want is the one that
        --      failed.
        --   3. Unlinking the file under a still-running dev server leaves a
        --      server bound to an unlinked inode, writing to storage nothing can
        --      open. The run wrapper does not stop the server it started.
        --
        -- Reason 1 is worth stating precisely, because the obvious form of it is
        -- too strong: the in-wrapper gate is ORDERED before the opt-in discard,
        -- so a run-end discard would not by itself have broken it. What a
        -- run-end discard genuinely forbids is the STANDALONE post-run
        -- invocation (`bun run check:e2e-residue`), which 52bb5db7 kept
        -- deliberately, and it makes the retired guidance's own instruction —
        -- "copy anything you need OUT before this runs" — unworkable for a check
        -- whose input is the whole database.
        --
        -- ORDERING, which this language cannot express: the discard happens
        -- before the copy, in one provisioning step. Two rules fire on
        -- TestRunStarted and nothing here sequences them; the guarantee lives in
        -- e2e_db_provision_run, which removes and then copies.
        -- The -wal and -shm sidecars travel with the file. Copying a database
        -- while a -wal exists yields a torn snapshot that opens cleanly and is
        -- missing the most recent writes; removing the database and leaving a
        -- -wal is the same bug with the halves swapped.
        -- E2E_REUSE_SERVER declines provisioning altogether — a reused server
        -- holds the DATABASE_URL it started with — so it also declines this
        -- discard, and the previous run's database is what the run then uses.
}

rule DiscardRunDatabaseAtExitIsOptIn {
    -- The retired behaviour survives as an OPT-IN: E2E_KEEP_RUN_DB=0 discards at
    -- exit for a caller who wants nothing left on disk.
    when: TestRunFinished(setup)
    requires: exists setup.database
    requires: not setup.keep_run_database
    ensures:
        setup.database.status = discarded
        setup.database.file_present = false

    @guidance
        -- Ordered AFTER the residue gate, deliberately: the gate is the last
        -- reader of the database, so discarding first would silently turn the
        -- gate into a permanent skip ("no run database") rather than a failure.
        -- A check that cannot run must say so; one that cannot run BY
        -- CONSTRUCTION is a check that has been switched off without anyone
        -- deciding to.
}

------------------------------------------------------------
-- Rules: Self-Contained Tests (Anti-Flaky)
------------------------------------------------------------

rule SelfContainedCrudTest {
    -- EVERY CRUD test must be independently runnable: it begins owning nothing.
    -- No row it will touch was inherited from an earlier test, in this run or
    -- any other.
    when: CrudTestExecutes(test_case)
    requires: test_case.file.category = crud
    ensures: test_case.owned_rows.count = 0

    @guidance
        -- This is the START-state half of the guarantee; the END-state half is
        -- the invariant SettledTestCaseOwnsNoLeakedRow. Together they bracket
        -- the test: owns nothing before, owns nothing after.
        -- The rule used to end `ensures: test.uses_storage_state = true`, which
        -- asserted an auth property that has nothing to do with independence.
        -- That claim now lives in the invariant StorageStateFollowsCategory,
        -- which is about test FILES, where it belongs.
}

rule UniqueTestData {
    -- WHEN a CRUD test creates data, the row's label carries an identifier that
    -- discriminates on BOTH axes a name can collide on: the millisecond it was
    -- generated in, and the worker that generated it. Concurrent workers inside
    -- the same run therefore cannot collide.
    when: CrudTestCreatesData(test_case, row)
    let identifier = TestDataIdentifier{uid: timestamp_base36_and_worker()}
    requires: row.owner = test_case
    ensures:
        row.label = labelled_with(identifier.uid)
        row.carries_uid = true

    @guidance
        -- Was: `TestDataIdentifier{uid: timestamp_base36()}` — the millisecond
        -- stamp alone. That is sufficient only at one worker, and the suite does
        -- not run at one worker by configuration: playwright.config.ts sets
        -- `fullyParallel: true` with `workers: 3` locally, and CLAUDE.md
        -- documents E2E_WORKERS=4. Three workers entering the helper in the same
        -- millisecond produced the SAME name — and the name IS this suite's
        -- protection against collision, so the protection was absent exactly
        -- when it was needed. Closed by 4447b9fe (E2E-B29).
        -- Never observed in the wild, because the wrapper forces --workers=1.
        -- That makes it a structural hole rather than a reproduced failure, and
        -- structural is the worse kind: the configuration that opens it is the
        -- one a developer reaches for when the suite feels slow.
        -- The worker index is read from the ENVIRONMENT (TEST_PARALLEL_INDEX,
        -- set by the worker process) and not from test.info().parallelIndex,
        -- which throws when called from module scope where the helper lives.
        -- Absent outside a worker, where "0" is correct — there is no second
        -- worker to collide with. Do not "simplify" this to test.info().
        -- TrackedFactoryRegistersBeforeWrite takes the label as a parameter;
        -- this rule constrains what that parameter may be. They are not two
        -- writers of the same field.
        -- Cross-RUN uniqueness is no longer this rule's job. The run database
        -- is discarded, so there are no earlier runs' rows to collide with —
        -- the uid is an intra-run device only.
        -- The rule used to end `ensures: test.uses_storage_state = true`,
        -- an auth property unrelated to uniqueness; see
        -- StorageStateFollowsCategory.
}

rule FixtureOwnedTeardown {
    -- Supersedes CleanupOnFailure. The GUARANTEE is unchanged: cleanup executes
    -- even when an assertion throws. Only the mechanism changed.
    -- WHEN a test case settles — passed, failed OR skipped — the fixture that
    -- owns its rows tears down the ones a LATER TEST IN THIS RUN could observe.
    -- Ownership belongs to a Playwright fixture whose teardown the runner
    -- invokes itself, not to a hand-written test.afterEach and not to a
    -- statement at the end of the test body.
    when: TestCaseSettled(test_case)
    requires: test_case.has_settled
    ensures:
        for row in test_case.leaked_rows where model.visibility != invisible:
            TrackedDeleteConfirmed(row: row)

    @guidance
        -- SCOPE, narrowed 2026-09-02, and narrowed on the second attempt.
        -- Unnarrowed the rule demanded fixture-owned teardown from every spec
        -- and got it from 2 of 27 — a rule that is 93% violated does not
        -- constrain anything, it just makes the file wrong.
        --
        -- The FIRST narrowing was withdrawn before it was written, and the
        -- reason is the useful part. A measurement showed SmtpConfig,
        -- CompanyBlacklist and Question ending a run at zero residue, which was
        -- read as "these specs already own their rows, so only capacity-bound
        -- and singleton models need the rule". A falsification test destroyed
        -- that inference (E2E-B37): all three clean up INLINE at the end of the
        -- test body — the path a thrown assertion skips — so they measured zero
        -- because the run was GREEN, not because they own anything. One injected
        -- failing assertion before the inline delete leaves SmtpConfig at 1, an
        -- active per-user singleton. A measurement taken only on the passing
        -- path cannot answer a question about the failing path.
        --
        -- So the scope is NOT a list of convenient models. It is the property:
        -- a row whose survival a LATER TEST IN THE SAME RUN can observe must be
        -- removed on a path that a thrown assertion cannot skip. Three ways a
        -- row is observable, and unique_keyed is the one that gets forgotten
        -- because it looks like nothing (see enum IntraRunVisibility).
        -- Everything else is covered by the disposable run database — and only
        -- ACROSS runs. Within a run, nothing collects an invisible row; that is
        -- what makes it invisible, not a promise that it is harmless.
        --
        -- MECHANISM, which the scope does not weaken: a fixture cannot be
        -- forgotten the way an afterEach can. The test signature requests the
        -- fixture, so any test that uses the factory necessarily gets the
        -- teardown; an afterEach has to be remembered per file. Measured
        -- 2026-09-02: of the 27 spec files, 25 have no afterEach at all, and the
        -- two that do (settings-api-keys, webhook-settings) only console.warn.
        -- An inline delete at the end of a test body is NOT this mechanism, and
        -- it is the shape E2E-B37 is about.
        -- Intra-run teardown still matters under a disposable database: several
        -- per-user caps (10 webhook endpoints, 10 active API keys) are reached
        -- WITHIN one run, and a leak there disables the create form for every
        -- later test in the same run.
        -- The residue gate is deliberately STRICTER than this rule: it fails on
        -- any unclassified growth, visible or not. That is not a contradiction —
        -- this rule says what must be torn down for the suite to be CORRECT, and
        -- the gate additionally catches the next spec that starts leaking, while
        -- the visibility is still nobody's problem.
        -- The rule used to end `ensures: test.uses_storage_state = true`; see
        -- StorageStateFollowsCategory.
}

------------------------------------------------------------
-- Rules: Entity Ownership
------------------------------------------------------------

rule TrackedFactoryRegistersBeforeWrite {
    -- The factory registers the row BEFORE it attempts the write.
    -- Registering afterwards loses exactly the rows that matter: a create that
    -- fails AFTER the row was written has still leaked one, and that is the
    -- failure mode teardown exists for.
    when: TrackedFactoryInvoked(test_case, label, model)
    ensures: OwnedRow.created(
        owner: test_case,
        model: model,
        label: label,
        carries_uid: true,
        status: registered,
        deletion_confirmed: false
    )

    @guidance
        -- Registration is the factory's own first statement, so no caller can
        -- forget it. A row registered whose write never landed is harmless:
        -- it stays `registered`, is not a leak, and teardown skips it.
        -- The MODEL is registered alongside the label because teardown scope
        -- depends on it (FixtureOwnedTeardown): a fixture that knows only the
        -- label cannot tell a row a later test will collide with from one
        -- nothing will ever look at.
}

rule TrackedRowWritten {
    -- The write is observed to have landed. `written` is reachable only from
    -- `registered` (see the transition graph on OwnedRow), which is how
    -- "registration happens before the write" is enforced rather than asked for.
    when: TrackedWriteObserved(row)
    requires: row.status = registered
    ensures: row.status = written
}

rule TrackedRowReleasedOnConfirmedDelete {
    -- De-registration happens ONLY on a proven-successful delete.
    -- An optimistic release leaves the fixture believing a row is gone while it
    -- still occupies a per-user cap — the leak becomes invisible instead of
    -- being reclaimed at teardown.
    when: TrackedDeleteConfirmed(row)
    requires: row.status = written
    ensures:
        row.deletion_confirmed = true
        row.status = released

    @guidance
        -- "Proven" means an observed success signal — the delete confirmation
        -- toast, or a re-query showing the row absent — not merely that the
        -- delete call returned.
}

------------------------------------------------------------
-- Rules: Console Oracle
------------------------------------------------------------

rule ConsoleOracleCoversActPhaseOnly {
    -- An assertion over browser console output covers the ACT phase only.
    -- Arming it before the arrange-phase navigations folds every setup request
    -- into the assertion, which is the reason unrelated environment noise had
    -- to be filtered out at all: the filter was compensating for a window that
    -- was too wide.
    when: ConsoleOracleArmed(test_case)
    requires: test_case.outcome = running
    ensures: ConsoleOracle.created(
        test_case: test_case,
        armed_in: act,
        asserted_in: act
    )

    @guidance
        -- Narrowing the window is what makes the oracle worth having: inside
        -- the act phase an unexpected console error IS the finding, so it need
        -- not be excused.
}

rule ToleranceFailsClosed {
    -- A tolerated artefact is tolerated only while its stated condition holds.
    -- WHEN the condition lapses, suppression lapses with it and the oracle
    -- fails again, so a tolerance cannot outlive the reason it was granted.
    when: toleration: ConsoleToleration.condition_holds transitions_to false
    ensures: toleration.oracle.test_case.outcome = failed

    @guidance
        -- Every toleration must name its condition, e.g. "favicon 404s occur
        -- because the dev server serves no favicon". When the app starts
        -- serving one, that condition is false and the pattern stops being
        -- excused — rather than silently masking a real favicon error forever.
        -- An unconditional deny-list cannot expire and is therefore forbidden.
}

------------------------------------------------------------
-- Rules: Shared Helpers
------------------------------------------------------------

-- SingleSourceHelpers describes where source files live and what they may
-- import. That is a property of the repository tree, not of any entity's state
-- at a point in time, so it has no expression-bearing form: there is nothing to
-- navigate to and nothing to compare. It stays a prose @invariant in the
-- TestConventions contract above (NOT in the Invariants section below, which
-- holds only expression-bearing invariants).

------------------------------------------------------------
-- Rules: Data Isolation
------------------------------------------------------------

-- PerRunDatabaseIsolation and SeedDataReadOnly describe test isolation
-- conventions that hold over source structure rather than entity state.
-- They are captured as prose invariants in the TestConventions contract.
-- The parts that ARE entity state — provisioning and discarding the run
-- database — are the rules above, not prose.

------------------------------------------------------------
-- Rules: One Spec Per Aggregate
------------------------------------------------------------

-- OneSpecPerAggregate describes a file-organisation convention. Same shape as
-- SingleSourceHelpers: a property of the tree, not of entity state.
-- Prose @invariant in the TestConventions contract above.

------------------------------------------------------------
-- Rules: Dev Server
------------------------------------------------------------

rule FreshDevServerPerRun {
    -- Supersedes ExternalDevServer, which claimed the dev server MUST be
    -- started externally and that the runner never starts or stops one.
    -- That has been false since 47369e15: the runner replaces the server on the
    -- port THIS WORKTREE owns with a fresh, correctly configured one on every
    -- run.
    -- Reuse is unsound because two run-scoped fixtures live in the server
    -- PROCESS rather than in the database — module activation latches on a
    -- dbSynced flag and is read once per process, and `next dev` memory grows
    -- across a suite — so a reused server carries state no database reset can
    -- reach.
    -- Was: "REPLACES whatever answers on the E2E port". Since 0e1b5fca there is
    -- no such thing as THE E2E port, and "whatever answers" is exactly the
    -- overreach that let one run take down a sibling's server: what the runner
    -- replaces is the server on its own worktree's port, and only when that
    -- server is running out of this worktree (rule OwnershipCheckedStop).
    when: TestRunStarted(setup)
    requires: not setup.reuse_server
    ensures: setup.dev_server_started_by_runner = true

    @guidance
        -- The surviving true part of the old rule is scoped by CONCURRENCY, not
        -- by identity: see @invariant StopScopedByConcurrencyNotIdentity. The
        -- wrapper kills and restarts one deliberately, as a documented step of
        -- the run, because it is in a position to know that nothing else is
        -- running; a subagent is not.
        -- PlaywrightRunner.web_server.reuse_existing_server stays true: the
        -- wrapper has already started the server by the time Playwright looks,
        -- so Playwright reuses THAT one rather than starting a third. That now
        -- also requires web_server.base_url to name the same port the wrapper
        -- bound — a Playwright still pointed at the base port would "reuse" a
        -- DIFFERENT worktree's server and report nothing unusual.
        -- The cost is one cold compile per run, bought deliberately: a suite
        -- whose result depends on how many times it ran before is not measuring
        -- the tree.
}

rule ReusedDevServerIsOptIn {
    -- The opt-out exists for a single-spec loop where the process state is
    -- known clean. It must be requested explicitly and is never the default.
    when: TestRunStarted(setup)
    requires: setup.reuse_server
    ensures: setup.dev_server_started_by_runner = false

    @guidance
        -- E2E_REUSE_SERVER=1. Not for a full run: the module-state fixture is
        -- per-process, so a reused server can fail
        -- automation-wizard-modules.spec.ts on its own precondition — and fail
        -- it in a way that looks like a product bug.
        -- What is reused is the server on THIS worktree's port. The opt-in never
        -- reaches across worktrees, so it cannot silently borrow a sibling's
        -- server; it can only decline to replace its own.
        -- It also declines ProvisionRunDatabase: a reused server holds the
        -- DATABASE_URL it was started with, so provisioning a copy here would
        -- put the app and the runner on different databases — a failure that
        -- names neither.
}

------------------------------------------------------------
-- Rules: Dev Server Ownership
------------------------------------------------------------

-- Three mechanisms, composed, for one problem: parallel workers stopping each
-- other's dev server. Each covers what the one below it cannot.
--
--   1. A port per worktree (invariant WorktreeScopedPort). Two worktrees no
--      longer contend at all, so the common case needs no coordination.
--   2. A lock per port (invariant DevServerExclusiveLock). Two starts in the
--      SAME worktree — two terminals, an orchestrator and its subagent — see
--      each other before one replaces the other's server.
--   3. A stop scoped to port AND directory (rule OwnershipCheckedStop). The
--      backstop for anything that bypasses 1 and 2.
--
-- Degradation is deliberate and ordered: if mechanism 2 is lost — a runtime
-- that closes the inherited descriptor would free the lock early — 1 and 3 still
-- hold. That is a weaker guarantee, not a broken one.

rule AcquirePortLockBeforeStart {
    -- The lock is taken BEFORE the server process exists, which is what makes
    -- the claim atomic: there is no window in which two starters have both
    -- looked and neither has claimed.
    when: DevServerStartRequested(_, worktree)
    let lock = PortLock{port: worktree.port}
    requires: not exists lock.holder
    ensures:
        let server = DevServer.created(
            worktree: worktree,
            port: worktree.port,
            status: starting
        )
        lock.holder = server

    @guidance
        -- The holder recorded here is the SERVER, not the starting script.
        -- Implemented by acquiring on a file descriptor that survives exec and
        -- then exec'ing the server onto it, so the lock is released exactly when
        -- the server dies — killed or not — with no cleanup path to forget.
        -- ORDERING, and it is the load-bearing part: a run that wants a fresh
        -- server must STOP the incumbent BEFORE it takes the lock. The incumbent
        -- left behind by the previous run in this same worktree is a live
        -- process holding the lock, and the lock cannot tell it apart from a
        -- sibling three minutes into a suite — only the working directory can,
        -- which is what OwnershipCheckedStop reads. Acquire-then-stop therefore
        -- refuses the one eviction that is always legitimate: reclaiming one's
        -- own.
        -- RESOLVED in f98bb779 (E2E-B33), and resolved by SPLITTING the two
        -- entry points rather than by reordering one of them — which is why this
        -- rule still says acquire-first and is still right. A DIRECT start
        -- (scripts/dev-e2e.sh) keeps lock-then-stop, because its correct answer
        -- to an occupied port is to REFUSE: it cannot know whose server that is.
        -- The RUN WRAPPER's contract is the opposite — it always replaces — so
        -- the stop moved into the wrapper, where it is scoped to this worktree,
        -- followed by a check that the lock actually came free rather than an
        -- assumption that the stop implied it.
        -- The symptom this closed is worth keeping, because nothing in it named
        -- the cause: the second consecutive run in one worktree met its own
        -- previous server, the starter exited 75 into a backgrounded nohup whose
        -- status nobody read, and the readiness poll then answered YES against
        -- the OLD server — while the run database had already been provisioned
        -- fresh. Two databases in one run, a green start, and no message.
        -- Hence also: a start's exit status must be READ. A refusal a caller
        -- discards is not a refusal (see ContendedStartIsRefused).
}

rule ContendedStartIsRefused {
    -- WHEN the port is already claimed, the start REFUSES. It does not wait and
    -- it does not take over: the holder may be three minutes into a suite, and
    -- the starter has no way to find out.
    when: DevServerStartRequested(_, worktree)
    let lock = PortLock{port: worktree.port}
    requires: exists lock.holder
    ensures: DevServerStartRefused(port: worktree.port, holder: lock.holder)

    @guidance
        -- The refusal is LOUD and names the holder — its pid, its working
        -- directory and when it started — because "port busy" alone sends the
        -- reader looking for a leaked process when the answer is usually a
        -- second window in the same checkout.
        -- A refusal that a caller cannot see is not a refusal: a starter
        -- launched into the background has its exit status discarded, and then
        -- the run continues against the incumbent as if the start had succeeded.
}

rule PortLockReleasedWhenServerExits {
    -- The claim outlives the starting script and dies with the SERVER.
    when: server: DevServer.status transitions_to stopped
    for lock in PortLocks where holder = server:
        ensures: lock.holder = null

    @guidance
        -- Not a teardown step anybody runs — that is the point. A release that
        -- has to be executed is a release that a SIGKILL, a crash or an early
        -- `exit` can skip, and the resulting stale claim is indistinguishable
        -- from a live one.
}

rule OwnershipCheckedStop {
    -- A stop names TWO coordinates: the port, and the directory the process
    -- must be running out of. It proceeds only when the process on that port
    -- belongs to the worktree asking.
    when: DevServerStopRequested(_, stop)
    requires: stop.permitted
    ensures: stop.target.status = stopped

    @guidance
        -- The requester is DISCARDED (`_`) on purpose. Ownership is a property
        -- of the process being stopped, not of who is asking, so the rule has
        -- nothing to branch on. Who may ask at all is a separate question, and
        -- one this model cannot answer formally — see
        -- @invariant StopScopedByConcurrencyNotIdentity.
        -- Ownership is the working directory, which /proc knows and a command
        -- line cannot express: `next dev` and `next-server` produce the same
        -- argv in every checkout, so `pkill -f "next dev"` matched every
        -- worktree on the machine and the operator could not tell from the
        -- output that it had.
        -- Signal the SUPERVISOR, not the listener. `next dev` respawns
        -- `next-server` within seconds, so a stop aimed at the listening pid
        -- alone appears to succeed and leaves the same supervisor serving one
        -- child later — which is what an earlier teardown was misread as
        -- "a new server appeared".
        -- The two coordinates do different jobs: the port narrows WHICH server,
        -- the directory decides WHETHER. A stop that names only the directory is
        -- therefore still sound — it stops every dev server this worktree owns
        -- rather than one of them — which is what a general-purpose stop wants.
        -- Dropping the DIRECTORY is the unsound direction, and is what the old
        -- port-only and argv-only stops did.
        -- machine_wide (STOP_ALL_WORKTREES=1) is the deliberate sweep and the
        -- only way past this guard. It is for cleaning up after everything, not
        -- for getting an inconvenient refusal out of the way.
}

rule UnownedStopIsRefused {
    -- A stop against a process this worktree does not own leaves it running.
    when: DevServerStopRequested(_, stop)
    requires: not stop.permitted
    ensures: DevServerStopRefused(target: stop.target, scope_root: stop.scope_root)

    @guidance
        -- The refusal must be visible and must name the directory the process
        -- IS running out of. A silent no-op reads as "nothing was there", and
        -- the caller then proceeds as though the port were free — which is the
        -- same end state as the bug this replaces, reached more quietly.
        -- "It leaves the target running" is not stated as an invariant: that
        -- compares two moments in time (the target may be stopped later, and
        -- legitimately), and invariants here hold at a single point in time.
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

-- Expression-bearing invariants: properties of entity state at a point in time.
-- Conventions about the source tree stay prose @invariants in the
-- TestConventions contract; they have no expression form.
--
-- HONEST LIMITATION, verified against allium 3.2.3 AND re-verified against
-- allium 3.6.1, both on 2026-09-02 (`allium --version`; the plugin cache
-- directory is numbered separately — 3.12.0 earlier today, 3.15.0 now — and is
-- NOT the tool version, so reading the path instead of asking the binary is an
-- easy way to record the wrong number here. The binary itself moved between the
-- two runs, which is why this note names two versions rather than correcting
-- one; the finding survived the upgrade unchanged):
-- `allium check` and `allium analyse` parse these bodies but do not RESOLVE
-- them. An invariant referring to a field that does not exist, an invariant
-- quantifying over an entity type that was never declared, and a transition
-- edge naming a state that does not exist all report zero errors.
--
-- Reproduction — append to a scratch COPY of this file:
--
--     invariant BogusFieldProbe {
--         for test_case in TestCases:
--             test_case.this_field_does_not_exist = 42
--     }
--
--     invariant BogusEntityProbe {
--         for x in ThingsThatWereNeverDeclared:
--             x.whatever
--     }
--
-- `allium check` then reports 0 errors and its diagnostic counts do not move at
-- all; `allium analyse` reports 0 findings naming either probe. Reproduced
-- FOUR times independently, 2026-09-02, across allium 3.2.3 and 3.6.1 — the
-- fourth during this tend pass, against 3.6.1, on the post-edit file: both
-- probes appended, counts stayed at 5 warnings / 33 infos, and `analyse`
-- returned 0 findings. The transition half was probed separately in the same
-- pass by adding the edge `discarded -> state_that_does_not_exist` to
-- RunDatabase; the counts did not move for that either.
-- Re-verifying was worth the two minutes: 3.6.1 DID add enforcement that 3.2.3
-- lacked (rule.invalidTrigger, which is what SPEC-B1 is about), so "the tool
-- got stricter somewhere" is not a safe assumption in either direction. It got
-- stricter about triggers and remains silent about references.
--
-- Corroborated from the opposite direction by a diagnostic the checker DOES
-- emit: `allium.entity.unused` fires for SQLiteDatabase, which is referenced by
-- name in RunDatabaseIsNeverTheWorkingDatabase below. It also fired for
-- DevServerStop while that entity appeared only in rule trigger parameters, and
-- stopped when a field-typed relationship (DevServer.stop_attempts) was added.
-- So "used" means referenced as a FIELD TYPE; references inside invariant
-- bodies and trigger parameter lists are not read at all. That is the same
-- non-resolution seen from the other side, and it means the unused-entity
-- warning is unreliable in both directions: it can accuse a referenced entity,
-- and it cannot vouch for an unreferenced one.
--
-- Do NOT write the quantifier as `all t in TestCases:`. That is not the syntax,
-- and it yields parse errors that look like the checker catching the bogus
-- field when it is only catching the malformed `all`. A probe that exercises
-- the parser instead of the resolver supports the opposite conclusion, so
-- anyone repeating this experiment can talk themselves out of the finding.
--
-- So the value of writing these formally is a named, precisely shaped,
-- greppable claim a reviewer can check — NOT tool-enforced freedom from drift.
-- Read that together with ADR-044: the five-month drift there happened to a
-- prose invariant, and moving a claim into braces narrows the gap without
-- closing it. Do not treat a green `allium check` as evidence any of these hold.

invariant StorageStateFollowsCategory {
    -- Hoisted here from SelfContainedCrudTest, UniqueTestData and
    -- CleanupOnFailure, which each carried it verbatim as
    -- `ensures: test.uses_storage_state = true` — a formal clause asserting
    -- something none of the three rules was about. It is a property of test
    -- FILES, not an outcome of executing, creating data or failing.
    for file in TestFiles:
        (file.category = crud implies file.uses_storage_state)
        and (file.category = smoke implies not file.uses_storage_state)
}

invariant RunDatabaseIsNeverTheWorkingDatabase {
    -- The suite never opens the developer's prisma/dev.db, and never opens the
    -- template for writing either. Before DisposableRunDatabase the first half
    -- was not true: DATABASE_URL pointed at the same file the dev server used,
    -- and E2E_ALLOW_DESTRUCTIVE gated only the single unfiltered delete.
    for db in RunDatabases:
        for working in SQLiteDatabases:
            db.path != working.path
}

invariant TemplateSatisfiesDeclaredFixtures {
    -- Every fixture a spec file depends on is present in the template.
    -- A spec that needs a row nothing creates does not have a flaky test, it
    -- has an unstated precondition: e2e/crud/staging-details-sheet.spec.ts
    -- requires a pre-existing StagedVacancy and hard-fails when the database
    -- has none, because the alternative — skipping silently — turns a gap in
    -- coverage into a green badge.
    for template in SeedTemplates:
        for file in TestFiles:
            file.required_fixtures.all(f => f in template.seeded_fixtures)
}

invariant SettledTestCaseOwnsNoLeakedRow {
    -- The END-state half of SelfContainedCrudTest, and the surviving guarantee
    -- of the retired CleanupOnFailure: once a test has settled — PASSED, FAILED
    -- or SKIPPED — none of the rows it wrote are still standing.
    -- Quantifying over every terminal outcome is the whole point. An invariant
    -- that held only for passing tests would permit exactly the leak that made
    -- one load-induced failure disable every later webhook test, and it is the
    -- shape E2E-B37 found in three specs that clean up inline.
    for test_case in TestCases:
        test_case.has_settled implies test_case.leaked_rows.count = 0

    -- ENFORCEMENT. This invariant was prose with no mechanism until 52bb5db7;
    -- its only implementations were two per-file afterEach detectors that
    -- console.warn and never fail. What makes it real now is
    -- `scripts/check-e2e-residue.sh`, run by scripts/test-e2e.sh AFTER the
    -- Playwright process exits — NOT `allium check`, which does not resolve this
    -- expression at all (see the HONEST LIMITATION note above).
    --
    -- The gate works on models, not on test cases, so it enforces the two
    -- invariants below rather than this one directly. Read together they are the
    -- same property from two ends: this one says what a test owes, and those say
    -- what the database is allowed to look like when every test has paid.
    --
    -- WHAT IT SEES, and the distinction is load-bearing:
    --   INSERT residue — a row created and not deleted. A count delta finds it.
    --   UPDATE residue — a SEEDED row mutated and not restored. The count is
    --     UNCHANGED, so no count can find it. The gate ATTACHes the template and
    --     asks which rows that came FROM it carry an updatedAt later than this
    --     run's own provisioning timestamp. The ids decide which rows are the
    --     template's; a count cannot.
    --
    -- WHAT IT CANNOT SEE, stated here rather than discovered later:
    --   Profile, Job, Company, JobTitle and Location have no updatedAt column,
    --   so a mutation of a seeded row in ANY of them is invisible to both
    --   halves. It is not that the gate tolerates these — it cannot form an
    --   opinion. A test that edits the seeded default profile passes a green
    --   gate, and nothing here will ever say so.
    --
    -- PROVENANCE is what keeps a skip from becoming a plausible wrong answer:
    -- the provisioning timestamp and the template stamp live INSIDE the run
    -- database (see RunDatabase). A gate run against a database from a different
    -- template — the template was rebuilt, or the check was invoked hours later
    -- — detects the mismatch and SKIPS LOUDLY. It also skips when Playwright
    -- did not report at all, because a run killed by the cgroup or the timeout
    -- leaves a partial database nobody should judge.
}

invariant UnownedGrowthIsALeak {
    -- The INSERT half, at the granularity the gate can actually measure: a model
    -- that gained rows during the run must be one whose growth somebody has
    -- accounted for. `owned` means a test created them and owed their removal,
    -- so growth in an `owned` model is by definition a row nobody took back.
    for model in PersistedModels:
        model.rows_gained > 0 implies model.growth != owned

    -- known_debt satisfies this clause today and is NOT a hole in it: the four
    -- findings (E2E-B22 Person, E2E-B23 Referral, E2E-B24 Tag, E2E-B25 Resume /
    -- JobTitle / Company / Location) are recorded, printed on every run, and
    -- expected to be reclassified to `owned` as each is fixed. The verdict is
    -- the unit of progress — an entry moves, it is not merely deleted.
}

invariant SettledRunRestoresMutatedSeedData {
    -- The UPDATE half, which the leaked-row invariant above cannot express at
    -- all: a mutated SEED row is not an OwnedRow, because no test created it.
    -- Reading a seeded row is free; changing one and leaving it changed is not,
    -- and it is the harder leak to find precisely because nothing about the
    -- database's size changes.
    for model in PersistedModels:
        model.seed_rows_mutated > 0 implies model.mutation_allowed

    -- Only two models are allowed: ModuleRegistration, because the health
    -- monitor writes healthStatus on every probe and the noise cannot be told
    -- from a test's mutation, and UserSettings, the seeded singleton the
    -- settings specs legitimately drive.
    -- The first of those deserves a warning, because it is also the example the
    -- mechanism was BUILT for: deactivateModule upserts onto a ModuleRegistration
    -- row (src/actions/module.actions.ts:348) and a deactivated module is
    -- visible to later tests. Allowing mutation there means the motivating case
    -- is not the case this catches — see the open question at the foot of this
    -- file. What the mechanism does catch was verified against a seeded
    -- StagedVacancy, which is genuinely in the template and genuinely has an
    -- updatedAt.
}

invariant WorktreeScopedPort {
    -- Mechanism 1. The MAIN checkout keeps the base port; every LINKED worktree
    -- gets a different one, inside a bounded span above it. That the main
    -- checkout is the one that keeps 3737 is not arbitrary: the base port is in
    -- .env, in bookmarks and in muscle memory, so the rare case pays the move.
    -- A linked worktree therefore can never collide with the main checkout,
    -- which is the collision that used to happen every time.
    -- An explicit per-invocation override (JOBSYNC_PORT) sits OUTSIDE this
    -- invariant by design: it is how you deliberately point two checkouts at
    -- one port, and stating it as an exception here would turn the escape hatch
    -- into part of the rule.
    for worktree in Worktrees:
        (worktree.is_main_checkout implies worktree.port = config.dev_server_base_port)
        and (not worktree.is_main_checkout implies
                worktree.port > config.dev_server_base_port
                and worktree.port <= config.dev_server_base_port + config.worktree_port_span)

    -- NOT EXPRESSIBLE, and the more important half: the port is a pure FUNCTION
    -- of the worktree root AND the current set of worktrees — same inputs, same
    -- port, on every invocation, in every tool, after any restart. That is
    -- cross-instance agreement about the output of a computation, not a property
    -- of stored state, so this language cannot assert it (see the language
    -- reference on what invariants can express).
    -- Was stated as "a pure function of the worktree root" alone. That stopped
    -- being true when collision resolution started walking `git worktree list`
    -- in path order (f98bb779): the SET is a second input, and adding a worktree
    -- can therefore move a later one's port. Determinism at any one moment is
    -- what the mechanism needs and what it still has; stability across time is
    -- what it gave up, deliberately, to stop two checkouts sharing a slot.
    -- It is why the port is derived by hashing the path rather than handed out
    -- by a counter or picked at random: a counter would give two tools in the
    -- SAME worktree different answers, and then the runner, the server and the
    -- browser would each be looking somewhere else. That failure reads as "the
    -- login hangs", which names none of the three.
}

invariant DevServerExclusiveLock {
    -- Mechanism 2. At most one dev server per port.
    -- The language has no cardinality operator, so "at most one" is encoded
    -- through the lock's SINGLE-VALUED holder: every live server on a port must
    -- BE that one value, and two distinct live servers on one port cannot both
    -- satisfy that. Read it as the uniqueness constraint it is.
    for lock in PortLocks:
        for server in DevServers:
            (server.port = lock.port and server.status in {starting, serving})
                implies lock.holder = server
}

invariant LockHolderIsNeverAStoppedServer {
    -- The other half of mechanism 2, and the reason it needs no cleanup step:
    -- the claim is released exactly when the server dies, so a lock held by a
    -- process that is gone is a state this spec does not admit.
    -- What is NOT expressible here is the mechanism that buys it — that the
    -- claim lives on a descriptor the server inherits rather than in a teardown
    -- anybody has to run. That is a statement about how the release happens,
    -- not about any state; it stays prose on the PortLock entity.
    for lock in PortLocks:
        for server in DevServers:
            lock.holder = server implies server.status != stopped
}

invariant RunDrivesItsOwnWorktreesServer {
    -- The three mechanisms are only worth having if the run actually addresses
    -- the server they protect. A run whose base URL named a sibling's port would
    -- pass every ownership check and still be measuring the wrong tree — and it
    -- would look like a normal green run.
    for setup in GlobalSetups:
        for server in DevServers:
            setup.dev_server = server implies server.worktree = setup.worktree
}

invariant ConsoleOracleIsNeverTheOnlyAssertion {
    -- A catch that swallows the behavioural assertions leaves a test whose only
    -- surviving claim is "the console stayed quiet" — which passes against a
    -- page that never rendered at all.
    -- behavioural_assertions is a source-level count the checker cannot
    -- compute; the invariant is stated formally anyway so the property has a
    -- name to cite in review, rather than living only in a comment.
    for test_case in TestCases:
        exists test_case.console_oracle
            implies test_case.behavioural_assertions >= config.min_behavioural_assertions

    -- ENFORCEMENT, since 4d558142:
    -- `__tests__/e2e-no-swallowed-assertions.spec.ts` walks e2e/ and flags a
    -- `try` whose body contains `expect(` and whose `catch` neither rethrows,
    -- asserts, calls test.skip(), nor carries a `// swallow-ok: <reason>`
    -- marker. It is a lexical heuristic, not a TypeScript parse, because the
    -- shape it looks for is lexical. It lives in Jest because Jest runs in CI
    -- and Playwright does not — a check that can run automatically should.
    --
    -- A SKIP IS AN HONEST OUTCOME AND A LOG IS NOT. This is the whole reason
    -- test.skip() is accepted and console.log is not, and it is a claim about
    -- REPORTING, not about coverage: a skipped test is reported as NOT RUN,
    -- while the console.log it replaces reported PASSED. Both leave the same
    -- gap in what was verified; only one of them tells you the gap is there.
    -- A green badge covering an unexercised page is the failure mode this
    -- invariant exists for, and logging is how it was reached (E2E-B27).
    --
    -- The three fixed sites did not have one answer, which is the point:
    --   Two now skip, because they drive a combobox backed by
    --     /api/eures/locations — a proxy to an EU service this suite does not
    --     control. Unavailability there is not a defect in this tree.
    --   One had its try/catch REMOVED. It waited on Job Source options, which
    --     prisma/seed.ts creates nine of; that is local, seeded, deterministic
    --     data, so an absent option list is a defect and must fail. Skipping
    --     would have been the same lie in a more honest tone.
    -- The four remaining sites are cleanup and idempotent-precondition helpers
    -- that SHOULD swallow — a throwing teardown replaces the real failure with
    -- its own — and each carries its marker and its reason.
    --
    -- WHY THE OPT-OUT IS A MARKER AT THE SITE, not a path+line allowlist in the
    -- checking test: a list drifts the first time anyone edits those specs, and
    -- its reasons live a directory away from the code they excuse. The marker
    -- is read by whoever next looks at the catch, which is the only reader who
    -- can tell whether the reason still holds. Same argument as
    -- ConsoleToleration.suppresses, one level up: an excuse that cannot be
    -- re-evaluated where it applies stops being an excuse and becomes a habit.
    --
    -- WHAT THIS DOES NOT CLOSE: the detector finds assertions swallowed by a
    -- CATCH, which is how the count reached zero in every case observed. It
    -- cannot count behavioural_assertions, so a test that has a console oracle
    -- and simply never asserted anything else still satisfies the checker and
    -- violates this invariant. That residue is review-enforced — see the open
    -- question at the foot of this file.
}

------------------------------------------------------------
-- Actor Declarations
------------------------------------------------------------

actor Developer {
    identified_by: PlaywrightRunner where workers > 1
}

actor CI {
    identified_by: PlaywrightRunner where workers = 1
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface LocalExecution {
    facing runner: Developer
    context suite: PlaywrightRunner

    contracts:
        demands TestConventions

    provides:
        RunAll(runner, suite)
            -- ./scripts/test-e2e.sh
        RunSmoke(runner, suite)
            -- ./scripts/test-e2e.sh --project=smoke
        RunCrud(runner, suite)
            -- ./scripts/test-e2e.sh --project=crud
        RunSingleFile(runner, suite, path: String)
            -- ./scripts/test-e2e.sh <path>

    -- The wrapper, not bare `npx playwright test`, is the entry point: it is
    -- what provisions the run database and replaces the dev server (see
    -- ProvisionRunDatabase and FreshDevServerPerRun). Invoking Playwright
    -- directly skips both and silently runs against whatever is already there.

    exposes:
        suite.projects
        suite.workers
        suite.timeout

    @guidance
        -- Also exposes html_report, test_results and timing_metrics
        -- which are Playwright output artifacts outside this entity model.
}

surface CIExecution {
    facing runner: CI
    context suite: PlaywrightRunner

    contracts:
        demands TestConventions

    provides:
        RunAll(runner, suite)
            -- ./scripts/test-e2e.sh   (single worker, nice/ionice, memory cgroup)
            -- Was documented as `--project=chromium`, which never existed:
            -- the projects are "smoke" and "crud".

    exposes:
        suite.projects
        suite.workers

    @guarantee ResourceSafe
        -- CI execution uses nice -n 10 and --workers=1 to avoid
        -- race conditions under tight NixOS VM resources.
}

surface PlaywrightConfig {
    facing runner: Developer
    context suite: PlaywrightRunner

    exposes:
        suite.global_setup
        suite.projects
        suite.workers
        suite.timeout
        suite.web_server

    @guarantee PipelineOrder
        -- Projects execute in dependency order: smoke first, then crud.
        -- Smoke failure prevents crud execution.
}

surface DevServerControl {
    facing operator: Developer
    context worktree: Worktree

    provides:
        DevServerStartRequested(operator, worktree)
            -- ./scripts/dev.sh  |  ./scripts/dev-e2e.sh
        DevServerStopRequested(operator, stop: DevServerStop)
            -- ./scripts/stop.sh, and the stop the run wrappers take before
            -- starting their own server

    exposes:
        worktree.root
        worktree.port

    -- The wrappers are the surface. A bare `kill` reaches the same processes
    -- and skips the ownership check entirely, which is why the prohibition in
    -- @invariant StopScopedByConcurrencyNotIdentity is about the ENTRY POINT
    -- and not about the outcome.

    @guarantee StopsOnlyWhatThisWorktreeOwns
        -- A stop through this surface never signals a process running out of a
        -- different worktree, whatever the port and whatever the command line.
        -- STOP_ALL_WORKTREES=1 is the one documented way past it.

    @guidance
        -- The actor here is the human operator or the orchestrating agent.
        -- The distinction that actually governs stopping — orchestrator versus
        -- SUBAGENT — is NOT expressible as an actor in this model: both drive
        -- the same scripts from the same checkout, and nothing in the entity
        -- model distinguishes them. It stays prose in
        -- @invariant StopScopedByConcurrencyNotIdentity. Naming a `Subagent`
        -- actor here would be a formal clause with nothing behind it.
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

open question "Should storageState be refreshed mid-run if NextAuth session expires during long test suites?"
open question "Should a future Phase introduce per-test database transactions for stronger isolation (e.g., SQLite savepoints)?"
open question "Should waitForTimeout calls be systematically replaced with event-based waits, or is the debounce pattern acceptable?"

-- Raised while reconciling this spec with the disposable-database decision.

open question "Should e2e/helpers/index.ts become a STRICT barrel? Today it does not re-export resume-fixture.ts and six spec files import e2e/helpers/resume-fixture directly, so SingleSourceHelpers is written to permit direct submodule imports. Making it strict is a one-line re-export plus six import rewrites, but it is a code change nobody has approved."

-- ANSWERED 2026-09-02, kept as a record of what closed them.
--
-- "Who rebuilds the seed template when a Prisma migration lands, and how does a
--  run detect that its template predates the schema?" — the run does, itself and
--  every time: SeedTemplate.stamp digests the schema, the migrations and both
--  seed scripts, and a mismatch rebuilds before provisioning. Nobody rebuilds it
--  by hand and no run can use a template that predates its own inputs. The
--  residual risk moved rather than vanished — see the open question on the stamp
--  input list below.
--
-- "Is e2e/cleanup-stale-data.ts retired outright, or kept for the
--  E2E_REUSE_SERVER path?" — retired outright in a0f9a320. All 330 lines, the
--  E2E_ALLOW_DESTRUCTIVE gate, and the cross-run purpose of the "E2E " name
--  prefix went with it. The reuse path did not keep it: a reused server holds an
--  unprovisioned database, which is a reason to warn, not a reason to keep a
--  purge whose filter had already drifted twice (E2E-B3, E2E-B22).
--
-- Raised while giving SettledTestCaseOwnsNoLeakedRow and
-- ConsoleOracleIsNeverTheOnlyAssertion their enforcement mechanisms (52bb5db7,
-- 4d558142). All four were found by reading the gate against the schema, not by
-- a failing run.

open question "TestCase.behavioural_assertions still cannot be counted by any tool the project runs. __tests__/e2e-no-swallowed-assertions.spec.ts closes the path by which the count reached zero in every observed case — a catch that discards a failing expect() — but a test that has a console oracle and simply never asserted anything else passes it. Is counting worth building, or is closing the observed path plus a named invariant enough?"

open question "ModuleRegistration is in the residue gate's ALLOWED_MUTATION list, and it is also the example the UPDATE check was BUILT for: deactivateModule upserts onto it (module.actions.ts:348) and automation-wizard-modules.spec.ts documents that later tests see the result. Worse, the seeds create no ModuleRegistration rows at all, so those rows are not in the template and the UPDATE check — which matches on ids present in the template — could not see them even unlisted. The mechanism is real and was verified against a seeded StagedVacancy; the motivating case is not the case it catches. Should module activation state be seeded into the template so it becomes checkable, or should the spec stop citing it as the motivating example?"

open question "EnrichmentResult is classified allowed_growth ('enrichment cache, keyed and TTL'd, not owned by a test') and is simultaneously unique_keyed on (userId, dimension, domainKey), which by IntraRunVisibility makes a leftover row observable by a later test in the same run — as a cache HIT rather than a constraint violation, so it changes behaviour silently rather than loudly. Is a cache genuinely exempt, or is this the first case where the growth verdict and the visibility class disagree and one of them is wrong?"

open question "The residue gate enumerates tables from the TEMPLATE, so a table that exists only in the run database is never examined. _e2e_meta is the only one today and its ALLOWED_GROWTH entry is therefore inert — harmless, but it reads as an active exemption. More usefully, it means the gate cannot see a table a MIGRATION added if that migration also rebuilt the template, which is the case where a new model's residue is least likely to be anticipated."

open question "SeedTemplate.stamp digests the schema, the migrations and the two seed scripts. Nothing else — so a change to a factory, a fixture helper or an env default that alters seeded CONTENT does not invalidate the template, and the next run silently uses one built from different behaviour. The stamp's input list is a claim about what determines the template's contents, and it is maintained by hand. What re-checks it?"

-- Raised while reconciling this spec with the per-worktree dev server decision
-- (0e1b5fca). All three were found by reading the scripts, not by a failing run,
-- and ALL THREE WERE ANSWERED by f98bb779 the same day. They are recorded here
-- rather than deleted, because each was answered in a way the question did not
-- offer, and the shape of that is the part worth keeping.
--
-- "Is the fix to stop before locking, to let a start reclaim a lock held from
--  its own worktree root, or to have test-e2e.sh check the starter's exit
--  status?" — the first and the third, and neither by changing dev-e2e.sh
--  (E2E-B33). The two entry points were given OPPOSITE contracts instead of one
--  shared ordering: a direct start still refuses an occupied port, while the run
--  wrapper stops its own incumbent first, confirms the lock came free, and reads
--  the starter's exit status. The middle option — letting a start reclaim by
--  worktree root — was not taken: it would have put the ownership decision back
--  inside the lock, where the working directory is not visible.
--  A second defect surfaced only once the first was fixed (E2E-B34):
--  devserver_stop waited for the PORT to free, but the port frees when the
--  listener dies while the lock is held by the tree root, which outlives it by a
--  beat. The stop returned with the lock still held. It now waits on the
--  processes. Worth remembering as a pattern: waiting on a PROXY for the thing
--  you care about is a race with a long fuse.
--
-- "Should dev.sh acquire too?" — yes, it does now. An ordinary development
--  server is visible to mechanism 2 instead of being discovered after the lock
--  was taken and the port found occupied.
--
-- "Widen the span, or detect the collision and say so?" — both, and neither was
--  sufficient alone. The span went 49 -> 200, which only makes collisions rarer;
--  what removes them is walking `git worktree list` in path order so the earlier
--  worktree keeps the contested slot. See config.worktree_port_span and the NOT
--  EXPRESSIBLE note on WorktreeScopedPort, which that change also weakened.

